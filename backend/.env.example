# --- Server
PORT=3000
NODE_ENV=production

# --- Database (Postgres via docker-compose)
# host = service name "db" inside the compose network
DATABASE_URL="postgresql://locus:CHANGE_ME_STRONG_PASSWORD@db:5432/locus?schema=public"

# --- Redis (Upstash) — used for leaderboard ZSETs
REDIS_URL="rediss://default:YOUR_UPSTASH_TOKEN@your-endpoint.upstash.io:6379"

# --- JWT
JWT_SECRET="CHANGE_ME_RANDOM_64_CHARS"
JWT_EXPIRES_IN="7d"

# --- Admin API (used by the Next.js admin dashboard)
ADMIN_API_TOKEN="CHANGE_ME_ADMIN_TOKEN"

# --- Postgres credentials (used by the db service)
POSTGRES_USER=locus
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=locus

# --- Host port the backend binds to (loopback only by default)
HOST_PORT=3001
